{
  "name": "pluck-n-play",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:scoreboard": "VITE_APP=scoreboard vite --host 0.0.0.0",
    "dev:pluck": "VITE_APP=pluck vite --host 0.0.0.0",
    "dev:plunk": "npm run dev:pluck --",
    "build": "tsc --noEmit && vite build",
    "build:scoreboard": "VITE_APP=scoreboard vite build",
    "build:pluck": "VITE_APP=pluck vite build",
    "build:plunk": "npm run build:pluck",
    "packets:pdf": "node scripts/build-packets.mjs",
    "import:mutopia": "node scripts/import-mutopia.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
